{
  "name": "karirkit-backend",
  "version": "1.0.0",
  "scripts": {
    "prisma:generate": "bunx prisma generate",
    "predev": "bunx prisma generate",
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "typecheck": "tsc --noEmit",
    "key:generate": "bun ./scripts/key-generate.js",
    "seed": "bun prisma/seed.ts",
    "pretest": "bunx prisma generate",
    "test": "bun test --isolate --preload ./tests/api/bun.setup.ts",
    "test:coverage": "bun test --isolate --preload ./tests/api/bun.setup.ts --coverage",
    "test:api:real": "cross-env RUN_REAL_API_TESTS=true bun test --isolate --preload ./tests/api/bun.setup.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.53",
    "@aws-sdk/client-s3": "^3.1123.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "ai": "^7.0.87",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.81.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "docx-templates": "^4.15.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-winston": "^4.2.0",
    "google-auth-library": "^10.9.1",
    "jsonwebtoken": "^9.0.3",
    "midtrans-client": "^1.4.3",
    "multer": "^2.3.0",
    "nodemailer": "^8.0.11",
    "pdfkit": "^0.18.0",
    "pino": "^10.3.1",
    "sharp": "^0.34.5",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "yamljs": "^0.3.0",
    "zod": "^4.5.4",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/midtrans-client": "^1.4.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "cross-env": "^10.1.0",
    "prisma": "^7.10.0",
    "supertest": "^7.2.2",
    "@types/bun": "latest"
  },
  "module": "src/server.js",
  "type": "module",
  "private": true,
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}